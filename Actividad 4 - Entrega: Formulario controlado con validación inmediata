import { useState } from "react";
import "./App.css";

function App() {
  const [formulario, setFormulario] = useState({
    nombre: "",
    correo: "",
    password: "",
    confirmarPassword: "",
    edad: "",
  });

  const [enviado, setEnviado] = useState(false);

  const validarFormulario = () => {
    const errores = {};

    if (formulario.nombre.trim() === "") {
      errores.nombre = "El nombre es obligatorio.";
    } else if (formulario.nombre.trim().length < 3) {
      errores.nombre = "El nombre debe tener al menos 3 caracteres.";
    }

    if (formulario.correo.trim() === "") {
      errores.correo = "El correo es obligatorio.";
    } else if (!/\S+@\S+\.\S+/.test(formulario.correo)) {
      errores.correo = "El correo no tiene un formato válido.";
    }

    if (formulario.password === "") {
      errores.password = "La contraseña es obligatoria.";
    } else if (formulario.password.length < 6) {
      errores.password = "La contraseña debe tener al menos 6 caracteres.";
    }

    if (formulario.confirmarPassword === "") {
      errores.confirmarPassword = "Debe confirmar la contraseña.";
    } else if (formulario.confirmarPassword !== formulario.password) {
      errores.confirmarPassword = "Las contraseñas no coinciden.";
    }

    if (formulario.edad === "") {
      errores.edad = "La edad es obligatoria.";
    } else if (Number(formulario.edad) < 18) {
      errores.edad = "Debes tener 18 años o más.";
    }

    return errores;
  };

  const errores = validarFormulario();
  const formularioValido = Object.keys(errores).length === 0;

  const manejarCambio = (e) => {
    const { name, value } = e.target;

    setFormulario({
      ...formulario,
      [name]: value,
    });

    setEnviado(false);
  };

  const manejarEnvio = (e) => {
    e.preventDefault();

    if (formularioValido) {
      setEnviado(true);
    }
  };

  return (
    <div className="contenedor">
      <form className="formulario" onSubmit={manejarEnvio}>
        <h1>Formulario Controlado</h1>
        <p className="descripcion">
          Aplicación React con useState y validación inmediata.
        </p>

        <div className="grupo">
          <label>Nombre</label>
          <input
            type="text"
            name="nombre"
            value={formulario.nombre}
            onChange={manejarCambio}
            placeholder="Escribe tu nombre"
          />
          {errores.nombre && <span className="error">{errores.nombre}</span>}
        </div>

        <div className="grupo">
          <label>Correo electrónico</label>
          <input
            type="email"
            name="correo"
            value={formulario.correo}
            onChange={manejarCambio}
            placeholder="ejemplo@gmail.com"
          />
          {errores.correo && <span className="error">{errores.correo}</span>}
        </div>

        <div className="grupo">
          <label>Contraseña</label>
          <input
            type="password"
            name="password"
            value={formulario.password}
            onChange={manejarCambio}
            placeholder="Mínimo 6 caracteres"
          />
          {errores.password && (
            <span className="error">{errores.password}</span>
          )}
        </div>

        <div className="grupo">
          <label>Confirmar contraseña</label>
          <input
            type="password"
            name="confirmarPassword"
            value={formulario.confirmarPassword}
            onChange={manejarCambio}
            placeholder="Repite la contraseña"
          />
          {errores.confirmarPassword && (
            <span className="error">{errores.confirmarPassword}</span>
          )}
        </div>

        <div className="grupo">
          <label>Edad</label>
          <input
            type="number"
            name="edad"
            value={formulario.edad}
            onChange={manejarCambio}
            placeholder="Escribe tu edad"
          />
          {errores.edad && <span className="error">{errores.edad}</span>}
        </div>

        <button type="submit" disabled={!formularioValido}>
          Enviar formulario
        </button>

        {enviado && (
          <p className="exito">Formulario enviado correctamente.</p>
        )}
      </form>
    </div>
  );
}

export default App;






